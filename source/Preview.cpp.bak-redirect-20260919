		// What the last capture produced, read by the page.
		// HOW OFTEN THE CAPTURE ACTUALLY RUNS (2026-09-19). It used to run on EVERY frame the
		// page drew: three CopySubresourceRegion of the capture rectangle (save the world pixels,
		// lift the model, put the world back), a ClearView, and a full engine render pass of the
		// model - at 4K with a large pane that is tens of megabytes of GPU copies a frame, for a
		// picture that had not changed since the last one. It was the larger half of the "huge FPS
		// drop - around 80%" phbd01 reported.
		//
		// The captured texture persists, so a capture is only needed when the PICTURE would differ:
		// a different item, a different pane size or model scale, a different background, or fresh
		// textures. A few frames are taken each time because the engine finishes building the model
		// inside its own Render(), so the first frame after a load has nothing on screen yet.
		constexpr int kCaptureFrames = 4;
		std::atomic<int> g_captureFramesLeft{ 0 };
		float g_lastPaneW = 0.0F, g_lastPaneH = 0.0F;
		float g_lastScale = 0.0F, g_lastBgR = -1.0F, g_lastBgG = -1.0F, g_lastBgB = -1.0F;

		// While the engine is still building the model there is nothing on screen to lift, so those
		// frames must not count against the capture budget - but they cannot be waited on forever
		// either, or a model that never builds would put the page back to rendering every frame.
		constexpr int kWaitFrames = 120;   // about two seconds
		std::atomic<int> g_captureWaitLeft{ 0 };

