	void DisplayUV(float& a_u0, float& a_v0, float& a_u1, float& a_v1)
	{
		const float texW = static_cast<float>(g_rtW ? g_rtW : kTexSize);
		const float texH = static_cast<float>(g_rtH ? g_rtH : kTexSize);
		const float capW = g_capturedW.load(), capH = g_capturedH.load();
		const float innerW = g_innerW.load(), innerH = g_innerH.load();
		const float w = innerW > 0.0F ? (std::min)(innerW, capW) : capW;
		const float h = innerH > 0.0F ? (std::min)(innerH, capH) : capH;
		// CLAMPED INSIDE THE COPIED BOX (2026-09-19). The window is centred on where the model
		// landed, and nothing stopped it running off the edge of what was actually copied this
		// frame - so it sampled the rest of a 2048-square texture that still held EARLIER captures,
		// and drew them as ghost copies of the model at other offsets. That is the repetition and
		// the "line of texture like a pencil on paper" in the owner's screenshots (2026-09-19): not
		// the engine drawing several times, our own crop reading stale pixels.
		float x0 = g_modelInTexX.load() - w * 0.5F;
		float y0 = g_modelInTexY.load() - h * 0.5F;
		x0 = std::clamp(x0, 0.0F, (std::max)(0.0F, texW - w));
		y0 = std::clamp(y0, 0.0F, (std::max)(0.0F, texH - h));
		a_u0 = x0 / texW; a_v0 = y0 / texH;
		a_u1 = (x0 + w) / texW; a_v1 = (y0 + h) / texH;
	}

	bool PaneRect(float& a_x0, float& a_y0, float& a_x1, float& a_y1)
	{
		ImGuiMCP::ImGuiIO* io = ImGuiMCP::GetIO();
		if (!io || io->DisplaySize.x <= 0.0F || io->DisplaySize.y <= 0.0F) { return false; }
		const float side = settings::preview::paneSize * io->DisplaySize.y;
		const float cx = settings::preview::paneX * io->DisplaySize.x;
		const float cy = settings::preview::paneY * io->DisplaySize.y;
		a_x0 = cx - side * 0.5F; a_y0 = cy - side * 0.5F;
		a_x1 = cx + side * 0.5F; a_y1 = cy + side * 0.5F;
		return true;
	}

