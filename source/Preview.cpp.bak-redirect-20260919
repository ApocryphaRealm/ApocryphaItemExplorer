		// The framework's stick calls, resolved once and null-checked. A framework older than 1.9.5
		// has neither, and the page simply has no controller handling rather than a null call.
		using SetSticksCaptured_t = void (*)(bool);
		using GetStick_t = bool (*)(int, float*, float*, bool*, bool*);

		SetSticksCaptured_t StickCapture()
		{
			static SetSticksCaptured_t fn = GetMenuFrameworkFunction<SetSticksCaptured_t>("AMF_SetSticksCaptured");
			return fn;
		}

		GetStick_t StickRead()
		{
			static GetStick_t fn = GetMenuFrameworkFunction<GetStick_t>("AMF_GetStick");
			return fn;
		}

		bool g_handling = false;
	}

	bool Handling() { return g_handling; }

	void BeginHandling()
	{
		if (g_handling) { return; }
		if (!StickRead() || !StickCapture()) { return; }   // nothing to handle it with
		g_handling = true;
		StickCapture()(true);
		RequestCapture();
		logger::info("preview: the box has the sticks (R3)");
	}

	void EndHandling()
	{
		if (!g_handling) { return; }
		g_handling = false;
		if (StickCapture()) { StickCapture()(false); }
		logger::info("preview: the box gave the sticks back");
	}

	void HandleController()
	{
		if (!g_handling) { return; }
		GetStick_t read = StickRead();
		if (!read) { EndHandling(); return; }

		float lx = 0.0F, ly = 0.0F, rx = 0.0F, ry = 0.0F;
		bool lClick = false, rClick = false, lLive = false, rLive = false;
		read(0, &lx, &ly, &lClick, &lLive);
		read(1, &rx, &ry, &rClick, &rLive);

		bool changed = false;

		// LEFT STICK TURNS. Per second rather than per frame, so the speed is the same whatever the
		// frame rate is doing - and this page exists partly because the frame rate was not steady.
		if (lLive)
		{
			const float dt = std::clamp(ImGuiMCP::GetIO() ? ImGuiMCP::GetIO()->DeltaTime : 0.016F, 0.0F, 0.1F);
			constexpr float kRadiansPerSecond = 2.5F;
			g_yaw.store(g_yaw.load() + lx * kRadiansPerSecond * dt);
			// Down on the stick tilts the top towards you, matching the mouse dragging downwards.
			g_pitch.store(std::clamp(g_pitch.load() - ly * kRadiansPerSecond * dt, -1.5F, 1.5F));
			changed = true;
		}

		// RIGHT STICK ZOOMS, up to go in.
		if (rLive && std::fabs(ry) > 0.0F)
		{
			const float dt = std::clamp(ImGuiMCP::GetIO() ? ImGuiMCP::GetIO()->DeltaTime : 0.016F, 0.0F, 0.1F);
			const float step = std::pow(2.0F, ry * dt);
			settings::preview::modelScale = std::clamp(settings::preview::modelScale * step, 0.25F, 8.0F);
			changed = true;
		}

		if (changed) { RequestCapture(); }
	}

	void ResetOrientation()
	{
		g_yaw.store(0.0F);
		g_pitch.store(0.0F);
		RequestCapture();
	}

	void HandleMouse(float a_x0, float a_y0, float a_x1, float a_y1)
	{
		if (!settings::general::show3DPreview) { return; }
		ImGuiMCP::ImGuiIO* io = ImGuiMCP::GetIO();
		if (!io) { return; }

		const float mx = io->MousePos.x;
		const float my = io->MousePos.y;
		const bool inside = mx >= a_x0 && mx <= a_x1 && my >= a_y0 && my <= a_y1;

		// TWO THINGS, AND ONLY TWO (the owner, 2026-09-19: "you hold left mouse button while on the
		// item and it rotates 360 and theres no need to move its position in the frame but i want
		// the scroll wheel to zoom in and out"). The first cut also moved the model about on the
		// right button, which was a mode nobody asked for and one more thing to explain.
		//
		// A turn that STARTED in the box keeps the mouse until the button comes up, so the model
		// does not stop turning the moment the pointer leaves the frame mid-drag.
		static bool s_turning = false;
		if (inside && io->MouseDown[0]) { s_turning = true; }
		if (!io->MouseDown[0]) { s_turning = false; }

		bool changed = false;

		if (s_turning && (io->MouseDelta.x != 0.0F || io->MouseDelta.y != 0.0F))
		{
			// About a hundredth of a radian per pixel, and the turn is never clamped or wrapped -
			// keep dragging and it keeps going round, as many times as you like.
			constexpr float kRadiansPerPixel = 0.01F;
			g_yaw.store(g_yaw.load() + io->MouseDelta.x * kRadiansPerPixel);
			// Up and down tilts it. Held short of straight over, where a model flips and the drag
			// stops reading as a turn at all.
			g_pitch.store(std::clamp(g_pitch.load() + io->MouseDelta.y * kRadiansPerPixel, -1.5F, 1.5F));
			changed = true;
		}

		if (inside && io->MouseWheel != 0.0F)
		{
			// Zoom is the capture rectangle, not the model: a bigger scale lifts a smaller piece of
			// the screen into the same box, so nothing has to be re-rendered at a different size.
			const float step = std::pow(1.15F, io->MouseWheel);
			settings::preview::modelScale = std::clamp(settings::preview::modelScale * step, 0.25F, 8.0F);
			changed = true;
		}

		if (changed) { RequestCapture(); }
	}

	void DrawFloating(const char* a_title)
	{
		if (!settings::general::show3DPreview) { return; }
		float x0 = 0.0F, y0 = 0.0F, x1 = 0.0F, y1 = 0.0F;
		if (!PaneRect(x0, y0, x1, y1)) { return; }
		ImGuiMCP::ImDrawList* dl = ImGuiMCP::GetForegroundDrawList();
		if (!dl) { return; }

		auto col = [](int r, int g, int b, int a) { return static_cast<ImGuiMCP::ImU32>((a << 24) | (b << 16) | (g << 8) | r); };
		// Black behind, a white frame around, the model opaque in front, nothing faded (the owner,
		// 2026-09-18).
		const int alpha = static_cast<int>(std::clamp(settings::preview::paneAlpha, 0.1F, 1.0F) * 255.0F);
		const auto bg = col(static_cast<int>(settings::preview::backgroundR * 255.0F), static_cast<int>(settings::preview::backgroundG * 255.0F),
							static_cast<int>(settings::preview::backgroundB * 255.0F), alpha);
		const ImGuiMCP::ImU32 kLine = col(255, 255, 255, 230);
		const ImGuiMCP::ImU32 kText = col(255, 255, 255, 240);
		const ImGuiMCP::ImU32 kDim = col(255, 255, 255, 150);

		// The faded background first, then the model OPAQUE on top of it: the capture is cleared to
		// transparent, so only the model's pixels land here (the owner, 2026-09-18: the model must
		// not look hazy).
		ImGuiMCP::ImDrawListManager::AddRectFilled(dl, ImGuiMCP::ImVec2{ x0, y0 }, ImGuiMCP::ImVec2{ x1, y1 }, bg, 0.0F, 0);
		if (HasImage())
		{
			float u0 = 0.0F, v0 = 0.0F, u1 = 1.0F, v1 = 1.0F;
			DisplayUV(u0, v0, u1, v1);
			ImGuiMCP::ImDrawListManager::AddImage(dl, TextureID(), ImGuiMCP::ImVec2{ x0, y0 }, ImGuiMCP::ImVec2{ x1, y1 },
												  ImGuiMCP::ImVec2{ u0, v0 }, ImGuiMCP::ImVec2{ u1, v1 }, col(255, 255, 255, 255));
		}

		// The framework's own theme frame - the Skyrim theme's Nordic knotwork (the owner, 2026-09-18:
		// "apply the same Nordic knotwork that's in the Skyrim theme for AMF to this texture rendering
		// frame") - through AMF_DrawThemeFrame (Apocrypha Menu Framework 1.8.9). A framework without the
		// export, or a theme without a frame, gets a plain white line instead.
		using DrawThemeFrame_t = bool (*)(void*, float, float, float, float);
		static DrawThemeFrame_t s_themeFrame = GetMenuFrameworkFunction<DrawThemeFrame_t>("AMF_DrawThemeFrame");
		if (!s_themeFrame || !s_themeFrame(dl, x0, y0, x1, y1))
		{
			ImGuiMCP::ImDrawListManager::AddLine(dl, ImGuiMCP::ImVec2{ x0, y0 }, ImGuiMCP::ImVec2{ x1, y0 }, kLine, 2.0F);
			ImGuiMCP::ImDrawListManager::AddLine(dl, ImGuiMCP::ImVec2{ x1, y0 }, ImGuiMCP::ImVec2{ x1, y1 }, kLine, 2.0F);
			ImGuiMCP::ImDrawListManager::AddLine(dl, ImGuiMCP::ImVec2{ x1, y1 }, ImGuiMCP::ImVec2{ x0, y1 }, kLine, 2.0F);
			ImGuiMCP::ImDrawListManager::AddLine(dl, ImGuiMCP::ImVec2{ x0, y1 }, ImGuiMCP::ImVec2{ x0, y0 }, kLine, 2.0F);
		}

		// The caption sits INSIDE the box, along its top edge (the owner, 2026-09-18: it was
		// spilling outside the bounds): the item's name, or what to do.
		const char* caption = nullptr;
		ImGuiMCP::ImU32 captionCol = kText;
		if (!Available()) { caption = strings::TR("AIE_PreviewUnavailable", "The 3D preview is not available on this runtime."); captionCol = kDim; }
		else if (a_title && a_title[0]) { caption = a_title; }
		else { caption = strings::TR("AIE_PreviewPickARow", "Point at an item to see it here."); captionCol = kDim; }
		// Centred across the box (the owner, 2026-09-18: "make the text centered in the 3D render box").
		const ImGuiMCP::ImVec2 textSize = ImGuiMCP::CalcTextSize(caption, nullptr, false, -1.0F);
		const float textX = (std::max)(x0 + 6.0F, (x0 + x1) * 0.5F - textSize.x * 0.5F);
		ImGuiMCP::ImDrawListManager::AddText(dl, ImGuiMCP::ImVec2{ textX, y0 + 8.0F }, captionCol, caption, nullptr);
	}

	bool MenuShouldClose()
	{
		std::scoped_lock l(g_lock);
		if (!g_heartbeatValid) { return true; }
		const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - g_heartbeat).count();
		return ms > kHeartbeatMs || !settings::general::show3DPreview;
	}

	void OnMenuShown()
	{
		if (g_running) { return; }
		if (auto* setting = Inventory3DSetting())
		{
			if (!setting->GetBool())
			{
				setting->data.b = true;
				g_settingForced = true;
				logger::info("preview: {} was off in the game's INI; on while the preview is open", kInventory3DSetting);
			}
		}
		else { logger::warn("preview: the game has no {} setting; the engine may refuse to build the model", kInventory3DSetting); }
		if (auto* mgr = RE::Inventory3DManager::GetSingleton())
		{
			mgr->Begin3D(RE::INTERFACE_LIGHT_SCHEME::kInventory);
			g_running = true;
			logger::info("preview: Begin3D(kInventory)");
		}
	}

	void OnMenuHidden()
	{
		if (auto* mgr = RE::Inventory3DManager::GetSingleton(); mgr && g_running)
		{
			mgr->UnloadInventoryItem();
			mgr->End3D();
		}
		g_running = false;
		g_current = nullptr;
		ReleaseTextures();
		if (g_settingForced)
		{
			if (auto* setting = Inventory3DSetting()) { setting->data.b = false; }
			g_settingForced = false;
		}
		logger::info("preview: End3D, model released");
	}

	void RenderFromMenu()
	{
		if (!g_running) { return; }
		RE::TESBoundObject* want = nullptr;
		float paneW = 0.0F, paneH = 0.0F;
		{
			std::scoped_lock l(g_lock);
			want = g_requested;
			paneW = g_paneW; paneH = g_paneH;
		}
		auto* inv = RE::Inventory3DManager::GetSingleton();
		if (!inv) { return; }

		if (want != g_current)
		{
			inv->UnloadInventoryItem();
			g_hasImage = false;
			if (want) { inv->LoadInventoryItem(want, nullptr); ++g_loads; }
			g_current = want;
			// A new item starts upright: carrying the previous item's angle over would show the
			// next one face-down with nothing to explain why.
			g_yaw.store(0.0F); g_pitch.store(0.0F);
			g_baseRotateValid = false;   // re-read from the new model on the next frame
			ClearCapturedImage();        // no pixels of the previous item may survive the swap
			RequestCapture();
		}
		if (!g_current || paneW <= 0.0F || paneH <= 0.0F) { return; }
		if (!g_texturesReady && !CreateTextures()) { return; }

		// Anything that would change the picture asks for a fresh capture; nothing else does.
		{
			const float scaleNow = settings::preview::modelScale;
			const auto moved = [](float a, float b) { return std::fabs(a - b) > 0.0005F; };
			if (moved(paneW, g_lastPaneW) || moved(paneH, g_lastPaneH) || moved(scaleNow, g_lastScale) ||
				moved(settings::preview::backgroundR, g_lastBgR) ||
				moved(settings::preview::backgroundG, g_lastBgG) ||
				moved(settings::preview::backgroundB, g_lastBgB))
			{
				g_lastPaneW = paneW; g_lastPaneH = paneH; g_lastScale = scaleNow;
				g_lastBgR = settings::preview::backgroundR;
				g_lastBgG = settings::preview::backgroundG;
				g_lastBgB = settings::preview::backgroundB;
				RequestCapture();
			}
		}

		// Nothing has changed since the last capture: the texture already holds the right picture,
		// so this frame costs the page nothing at all.
		if (g_captureFramesLeft.load() <= 0) { return; }
		--g_captureFramesLeft;

		// The rectangle: the pane, grown by the model scale (a smaller scale means capturing more
		// of the screen and shrinking it into the pane) and by the safety margin.
		// THE CAPTURE RECTANGLE IS FIXED, AND ZOOM SCALES THE MODEL (2026-09-19).
		//
		// It used to be the other way round: zoom was implemented by SHRINKING this rectangle
		// (expand = 1/modelScale), so that a smaller piece of the screen was lifted into the same
		// pane. That works until the rectangle becomes smaller than the area the engine actually
		// paints - and then the parts of the model outside it are never captured, never cleared and
		// never restored, so they are left on the live frame. That is the "second preview in the
		// bottom middle of the screen" and the smear "like a pencil on paper" the owner reported
		// while spinning a weapon zoomed right in, and his own reading of it was exactly right:
		// two areas, and tearing where they stop agreeing.
		//
		// The rectangle now depends only on the pane, so it always covers what is painted, and zoom
		// is applied to the MODEL's own scale below. Nothing can fall outside the rectangle any more
		// because the rectangle is no longer what zoom moves.
		const float scale = settings::preview::modelScale > 0.0F ? settings::preview::modelScale : 1.0F;
		const float innerW = paneW, innerH = paneH;

		// THE RECTANGLE IS SIZED FROM WHAT THE MODEL ACTUALLY PAINTS, NOT FROM THE PANE.
		//
		// Two wrong answers came before this one, and both had the same shape - a rectangle that did
		// not contain the paint. Sizing it as pane/zoom made it SHRINK as you zoomed in, so the
		// model's edges spilled out and were never restored (the "second preview" in the corner).
		// Sizing it from the pane alone, with zoom moved onto the model's scale, was worse: at full
		// zoom the model is eight times its size and paints across the whole screen, so the whole
		// screen kept the paint (the owner, 2026-09-19: "now on the entire computer screen behind
		// AMF"). Whichever way zoom works, the invariant is the same and it was never stated:
		//
		//     the capture rectangle must always cover the model's painted extent.
		//
		// So it is measured from the model's own bound, projected to the screen through the same
		// frustum the capture uses, grown by the safety margin, and never smaller than the pane.
		// The pane is still what the page SHOWS - the UVs crop this rectangle down to it.
		float paintedSide = 0.0F;
		{
			auto* scn0 = RE::UI3DSceneManager::GetSingleton();
			auto& rt0 = inv->GetRuntimeData();
			if (scn0 && !rt0.loadedModels.empty())
			{
				auto* m0 = rt0.loadedModels.back().spModel.get();
				if (m0 && m0->worldBound.radius > 0.0F && std::isfinite(m0->worldBound.radius))
				{
					const auto& vf0 = scn0->viewFrustum;
					const auto& t0 = m0->local.translate;
					const float worldW0 = -vf0.fRight * t0.y - (-vf0.fLeft * t0.y);
					const auto sz0 = RE::BSGraphics::Renderer::GetScreenSize();
					if (sz0.width > 0 && std::fabs(worldW0) > 1e-6F)
					{
						const float pxPerUnit = static_cast<float>(sz0.width) / std::fabs(worldW0);
						paintedSide = m0->worldBound.radius * 2.0F * pxPerUnit;
					}
				}
			}
		}
		const float side = (std::max)({ innerW, innerH, paintedSide });
		const float captureW = side * kSafetyMargin, captureH = side * kSafetyMargin;

		// The player's turn, applied to the model itself before anything is measured - the capture
		// rectangle is chosen from the model's world bound, and that bound moves when it rotates.
		{
			auto& rt = inv->GetRuntimeData();
			if (!rt.loadedModels.empty())
			{
				if (auto* model = rt.loadedModels.back().spModel.get())
				{
					if (!g_baseRotateValid)
					{
						g_baseRotate = model->local.rotate;
						g_baseScale = model->local.scale > 0.0F ? model->local.scale : 1.0F;
						g_baseRotateValid = true;
					}
					// Zoom, on the model itself. The capture rectangle above is fixed, so a bigger
					// model simply fills more of a rectangle that still contains it.
					model->local.scale = g_baseScale * scale;
					RE::NiMatrix3 turn;
					turn.SetEulerAnglesXYZ(g_pitch.load(), 0.0F, g_yaw.load());
					model->local.rotate = turn * g_baseRotate;
					RE::NiUpdateData update{};
					model->Update(update);
				}
			}
		}

		// Where the engine is about to paint the model: its bound centre projected through the UI
		// scene's frustum (Modex issue #48 - the projection the inventory itself uses).
		float capX = 0.0F, capY = 0.0F;
		bool centred = false;
		{
			auto* scn = RE::UI3DSceneManager::GetSingleton();
			auto& rt = inv->GetRuntimeData();
			if (scn && !rt.loadedModels.empty())
			{
				auto* model = rt.loadedModels.back().spModel.get();
				// A radius that is zero, negative or not a finite number means the bound has not been
				// rebuilt yet (or has been corrupted by a transform). Deriving a capture rectangle
				// from it produces the stretched, smeared picture rather than a wrong-but-sane one,
				// so the frame is skipped and the last good capture stays on screen.
				if (model && model->worldBound.radius > 0.0F && std::isfinite(model->worldBound.radius) &&
					std::isfinite(model->worldBound.center.x) && std::isfinite(model->worldBound.center.z))
				{
					const auto& vf = scn->viewFrustum;
					const auto& t = model->local.translate;
					const float worldMinX = -vf.fLeft * t.y;
					const float worldMinZ = -vf.fBottom * t.y;
					const float worldW = -vf.fRight * t.y - worldMinX;
					const float worldH = -vf.fTop * t.y - worldMinZ;
					const auto sz = RE::BSGraphics::Renderer::GetScreenSize();
					if (sz.width > 0 && sz.height > 0)
					{
						const float ratioX = worldW / static_cast<float>(sz.width);
						const float ratioY = worldH / static_cast<float>(sz.height);
						if (ratioX != 0.0F && ratioY != 0.0F)
						{
						const auto& c = model->worldBound.center;
							const float modelSX = -(c.x + worldMinX) / ratioX;
							const float modelSY = -(c.z + worldMinZ) / ratioY;
							capX = modelSX - captureW * 0.5F;
							capY = modelSY - captureH * 0.5F;
							centred = true;
							g_boundX = c.x; g_boundY = c.y; g_boundZ = c.z; g_radius = model->worldBound.radius;
							g_transX = t.x; g_transY = t.y; g_transZ = t.z;
							g_screenX = modelSX; g_screenY = modelSY;
							g_screenW = sz.width; g_screenH = sz.height;
						}
					}
				}
			}
		}
		if (!centred)
		{
			// The model has not been built yet: the engine finishes the load inside Render() itself, so
			// Render is called bare - nothing is on screen yet to capture - and the capture waits a frame.
			// That frame is given back, within the wait budget, so a slow load still ends in a picture.
			if (g_captureWaitLeft.load() > 0) { --g_captureWaitLeft; ++g_captureFramesLeft; }
			EngineRender(inv);
			return;
		}

		auto* renderer = RE::BSGraphics::Renderer::GetSingleton();
		if (!renderer) { return; }
		auto& data = renderer->GetRuntimeData();
		auto* context = reinterpret_cast<ID3D11DeviceContext*>(data.context);
		if (!context || !g_dstRTV || !g_depthDSV) { return; }

		// ---- REDIRECT, PAINT, RESTORE ----------------------------------------------------------
		// The whole of the old save/clear/render/capture/restore dance is gone. The engine paints
		// into the bound target, so the bound target becomes ours for the duration of one call.
		ID3D11RenderTargetView* prevRTV = nullptr;
		ID3D11DepthStencilView* prevDSV = nullptr;
		context->OMGetRenderTargets(1, &prevRTV, &prevDSV);

		UINT vpCount = 1;
		D3D11_VIEWPORT prevVP{};
		context->RSGetViewports(&vpCount, &prevVP);

		// Cleared to TRANSPARENT: the capture then carries only the model's own pixels, and the page
		// lays it over its own background exactly as before.
		const FLOAT clear[4] = { settings::preview::backgroundR, settings::preview::backgroundG,
								 settings::preview::backgroundB, 0.0F };
		context->ClearRenderTargetView(g_dstRTV, clear);
		context->ClearDepthStencilView(g_depthDSV, D3D11_CLEAR_DEPTH, 1.0F, 0);
		context->OMSetRenderTargets(1, &g_dstRTV, g_depthDSV);

		D3D11_VIEWPORT vp{};
		vp.TopLeftX = 0.0F; vp.TopLeftY = 0.0F;
		vp.Width = static_cast<float>(g_rtW); vp.Height = static_cast<float>(g_rtH);
		vp.MinDepth = 0.0F; vp.MaxDepth = 1.0F;
		context->RSSetViewports(1, &vp);

		EngineRender(inv);

		// Put the game's own targets back before anything else draws. Done unconditionally, on every
		// path out of here, because leaving our target bound would redirect the REST of the frame.
		context->OMSetRenderTargets(1, &prevRTV, prevDSV);
		if (vpCount > 0) { context->RSSetViewports(1, &prevVP); }
		if (prevRTV) { prevRTV->Release(); }
		if (prevDSV) { prevDSV->Release(); }

		// The model is at its projected position within a target the same size as the screen, so the
		// figures the page crops with are the ones already computed above.
		const int width = static_cast<int>(captureW);
		const int height = static_cast<int>(captureH);
		g_rectL = 0; g_rectT = 0; g_rectW = static_cast<int>(g_rtW); g_rectH = static_cast<int>(g_rtH);

		g_capturedW = static_cast<float>(width);
		g_capturedH = static_cast<float>(height);
		g_innerW = innerW;
		g_innerH = innerH;
		const float modelCX = capX + captureW * 0.5F, modelCY = capY + captureH * 0.5F;
		// No offset: the target IS the screen, so the model's projected position is its position here.
		g_modelInTexX = g_screenX.load() - settings::preview::offsetX;
		g_modelInTexY = g_screenY.load() - settings::preview::offsetY;
		g_hasImage = true;
		++g_renders;
	}

	Status GetStatus()
	{
		Status s;
		s.available = Available();
		s.menuOpen = PreviewMenuOpen();
		s.running = g_running;
		s.textures = g_texturesReady;
		s.currentFormID = g_current ? g_current->GetFormID() : 0;
		{
			std::scoped_lock l(g_lock);
			s.requestedFormID = g_requested ? g_requested->GetFormID() : 0;
			s.paneW = g_paneW; s.paneH = g_paneH;
			s.sinceHeartbeatMs = g_heartbeatValid ? std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - g_heartbeat).count() : -1.0;
		}
		s.loads = g_loads.load();
		s.renders = g_renders.load();
		if (auto* inv = RE::Inventory3DManager::GetSingleton()) { s.managerModels = static_cast<std::uint32_t>(inv->GetRuntimeData().loadedModels.size()); }
		s.capturedW = g_capturedW.load(); s.capturedH = g_capturedH.load();
		s.lastError = g_lastError;
		if (auto* setting = Inventory3DSetting()) { s.inventory3DSetting = setting->GetBool() ? 1 : 0; }
		s.settingForced = g_settingForced;
		s.rectL = g_rectL.load(); s.rectT = g_rectT.load(); s.rectW = g_rectW.load(); s.rectH = g_rectH.load();
		s.boundX = g_boundX.load(); s.boundY = g_boundY.load(); s.boundZ = g_boundZ.load(); s.radius = g_radius.load();
		s.transX = g_transX.load(); s.transY = g_transY.load(); s.transZ = g_transZ.load();
		s.screenX = g_screenX.load(); s.screenY = g_screenY.load(); s.screenW = g_screenW.load(); s.screenH = g_screenH.load();
		s.noRestore = g_noRestore.load();
		s.targetW = g_targetW.load(); s.targetH = g_targetH.load(); s.targetFormat = g_targetFormat.load();
		return s;
	}

	void SetNoRestore(bool a_on) { g_noRestore = a_on; }
